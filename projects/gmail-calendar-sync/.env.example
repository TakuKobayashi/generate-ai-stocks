# ===== Google OAuth (必須: 本番実行時) =====
# scripts/get-refresh-token.ts で取得します。GitHub Actions では Secrets に登録してください。
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=1//0xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 動作モード =====
# true にすると Gmail ラベル付け / カレンダー書き込みを一切行わず、予定アクションを表示するだけ
DRY_RUN=true
# true にすると Google API を使わず samples/*.eml を読み、メモリ上の偽カレンダーに登録 (デモ・スモークテスト用)
MOCK_GOOGLE=false
MOCK_SAMPLES_DIR=samples

# ===== Gmail =====
# 事前フィルタ用の Gmail 検索クエリ。処理済みラベルの除外条件は自動で付与されます。
GMAIL_QUERY=newer_than:14d -category:promotions -category:social (予約 OR 確認 OR チケット OR 予約番号 OR 搭乗 OR 宿泊 OR 診察 OR 受診 OR 招待 OR booking OR confirmation OR itinerary OR reservation OR ticket OR invitation)
PROCESSED_LABEL=calendar-sync/processed
REVIEW_LABEL=calendar-sync/needs-review
# 1 回の実行で処理する最大メール数 (CPU 推論は遅いので控えめに)
MAX_MESSAGES=10

# ===== Google Calendar =====
CALENDAR_ID=primary
# 低信頼度の予定を別カレンダーに入れたい場合に指定 (空なら CALENDAR_ID に【要確認】付きで登録)
REVIEW_CALENDAR_ID=
DEFAULT_TIMEZONE=Asia/Tokyo
# 宿泊: span = チェックイン日〜チェックアウト日の終日 1 件 / separate = チェックイン・チェックアウトの 2 件
LODGING_MODE=span
# キャンセル: mark = タイトルに【キャンセル】を付ける (既定) / delete = 削除
CANCEL_MODE=mark
# これ未満の信頼度は【要確認】(tentative) として登録し、Gmail に needs-review ラベルを付ける
MIN_CONFIDENCE=0.6
DEFAULT_EVENT_MINUTES=60

# ===== LLM (Ollama) =====
OLLAMA_HOST=http://127.0.0.1:11434
MODEL=qwen2.5:7b-instruct
NUM_CTX=8192
LLM_TIMEOUT_MS=900000
# auto = 決定的チェックで問題があった時 / 低信頼度の時だけ LLM 自己検証 / always / never
SELF_CHECK=auto
# LLM に渡す本文の最大文字数 (NUM_CTX から自動で更に絞られることがあります)
MAX_BODY_CHARS=6000

# ===== ログ =====
LOG_LEVEL=info
# true にするとログ / Step Summary の件名・差出人を伏せ字にする (公開リポジトリ向け)
REDACT_LOGS=false
