{
  "name": "gmail-calendar-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Gmail の予約・スケジュールメールをローカル LLM (Ollama) で解析し Google カレンダーへ登録するサンプル",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dry-run": "DRY_RUN=true tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "get-token": "tsx scripts/get-refresh-token.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "googleapis": "^185.0.0",
    "html-to-text": "^10.0.1",
    "luxon": "^3.7.2",
    "mailparser": "^3.9.38",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/luxon": "^3.7.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
